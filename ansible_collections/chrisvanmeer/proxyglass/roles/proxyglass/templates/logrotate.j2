{{ proxyglass_log_file }} {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    create 0640 {{ proxyglass_service_user }} {{ proxyglass_service_group }}
    su {{ proxyglass_service_user }} {{ proxyglass_service_group }}
    postrotate
        /bin/systemctl reload proxyglass.service >/dev/null 2>&1 || true
    endscript
}
