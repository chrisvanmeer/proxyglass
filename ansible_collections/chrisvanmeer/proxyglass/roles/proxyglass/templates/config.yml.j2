{% if proxyglass_config_content | length > 0 %}
{{ proxyglass_config_content }}
{% else %}
server:
  listen: "{{ proxyglass_listen }}"
  default_refresh: {{ proxyglass_default_refresh | default(5, true) | int }}

require_auth: {{ proxyglass_require_auth | bool | lower }}
tokens_file: "{{ proxyglass_tokens_path }}"
token_ttl_days: {{ proxyglass_token_ttl_days | int }}
log_path: "{{ proxyglass_log_file }}"

oidc:
  enabled: {{ proxyglass_oidc_enabled | bool | lower }}
  issuer: "{{ proxyglass_oidc_issuer }}"
  client_id: "{{ proxyglass_oidc_client_id }}"
  client_secret: "{{ proxyglass_oidc_client_secret }}"
  session_ttl_hours: {{ proxyglass_oidc_session_ttl_hours | int }}
  allowed_groups: {{ proxyglass_oidc_allowed_groups | to_nice_yaml | trim | indent(2) }}

targets: {{ proxyglass_targets | to_nice_yaml | trim | indent(2) }}

topology: {{ proxyglass_topology | to_nice_yaml | trim | indent(2) }}
{% endif %}