[Unit]
Description=Proxyglass HAProxy Stats Dashboard
After=network.target

[Service]
Type=simple
User={{ proxyglass_service_user }}
Group={{ proxyglass_service_group }}
ExecStart={{ proxyglass_install_path }} --config {{ proxyglass_config_path }}
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
