---
const features = [
  {
    number: '01',
    title: 'One view across your fleet',
    text: 'Connect to multiple HAProxy stats endpoints from one config file. Explore the environment in an interactive topology map.',
    icon: 'fleet',
  },
  {
    number: '02',
    title: 'Follow the traffic path',
    text: 'See frontends, backends and individual servers together, with sessions, byte counters, status and health-check details.',
    icon: 'path',
  },
  {
    number: '03',
    title: 'Find the last activity',
    text: 'Check each server’s last session and health check. Spot stale or unhealthy pool members before they surprise you.',
    icon: 'pulse',
  },
  {
    number: '04',
    title: 'Your view, your way',
    text: 'Filter by proxy, frontend, backend or server. Sort by metrics or keep your HAProxy targets in config-file order.',
    icon: 'filter',
  },
  {
    number: '05',
    title: 'No control-plane surprises',
    text: 'Proxyglass only reads stats. There are no buttons or API calls to disable, drain or otherwise change HAProxy state.',
    icon: 'lock',
  },
  {
    number: '06',
    title: 'Works without the internet',
    text: 'The UI assets ship with the binary. No CDN, hosted fonts or third-party runtime calls are needed to open the dashboard.',
    icon: 'offline',
  },
  {
    number: '07',
    title: 'Tokens or OIDC sign-in',
    text: 'Use locally generated bearer tokens or connect an OIDC provider. An optional group allow-list keeps access aligned with your identity provider.',
    icon: 'auth',
  },
  {
    number: '08',
    title: 'Native install is the default',
    text: 'Run a static Linux binary under systemd with config and environment in familiar /etc locations. No container platform is required.',
    icon: 'terminal',
  },
  {
    number: '09',
    title: 'Container when it fits',
    text: 'Use the optional image and Nomad example if that is how your infrastructure is operated. The same config and read-only behavior apply.',
    icon: 'deploy',
  },
  {
    number: '10',
    title: 'Draggable topology',
    text: 'Pan, zoom and drag nodes in the topology map to lay out your environment the way you think about it. Positions are saved in your browser and survive auto-refresh.',
    icon: 'path',
  },
];

const icons: Record<string, string> = {
  fleet: '<path d="M4 7.5 12 3l8 4.5-8 4.5-8-4.5Z"/><path d="m4 12 8 4.5 8-4.5M4 16.5 12 21l8-4.5"/>',
  path: '<circle cx="5" cy="12" r="2.5"/><circle cx="19" cy="6" r="2.5"/><circle cx="19" cy="18" r="2.5"/><path d="M7.5 11.5 16.5 6.5M7.5 12.5l9 5"/>',
  pulse: '<path d="M3 12h4l2.5-7 5 14 2.5-7h4"/>',
  filter: '<path d="M4 5h16M7 12h10m-7 7h4"/><circle cx="8" cy="5" r="1.5"/><circle cx="14" cy="12" r="1.5"/>',
  lock: '<rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 1 1 8 0v3m-4 5v2"/>',
  offline: '<path d="M3 9a14 14 0 0 1 18 0M6 12a9 9 0 0 1 12 0m-9 3a4 4 0 0 1 6 0m-3 4h.01"/><path d="m3 3 18 18"/>',
  auth: '<rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 1 1 8 0v3m-4 5v2"/>',
  terminal: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 10 3 2-3 2m6 0h4"/>',
  deploy: '<path d="M12 3v12m0 0 4-4m-4 4-4-4"/><path d="M5 18v2h14v-2"/>',
};
---

<section class="section wrap" id="features">
  <div class="section-heading">
    <span class="eyebrow"><i></i> Useful signal, less noise</span>
    <h2>Everything you need to see.<br /><span>Nothing you can accidentally change.</span></h2>
    <p>Proxyglass turns HAProxy’s stats feed into an operational overview, and deliberately stops at visibility.</p>
  </div>

  <div class="feature-grid">
    {features.map((feature) => (
      <article class="feature-card">
        <div class="feature-top"><span class="feature-number">{feature.number}</span><span class="feature-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[feature.icon]} /></span></div>
        <h3>{feature.title}</h3>
        <p>{feature.text}</p>
      </article>
    ))}
  </div>
</section>
